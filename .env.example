# HASH256 Rust GPU Miner — copy to .env and fill real values
# Keep .env private. Never commit private key or bot token.

# Ethereum mainnet RPC
RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_KEY
TX_RPC_URL=https://rpc.flashbots.net/fast

# Dedicated mining wallet private key
PRIVATE_KEY=0xYOUR_PRIVATE_KEY

# Safety switch
# false = dry-run, found nonce is logged/reported but NOT submitted
# true  = live submit mine(nonce), spends ETH gas
SUBMIT=false

# GPU / CPU
GPU=1
GPU_BATCH=4194304
GPU_MAX_ROUND_SECS=20
MINER_THREADS=8

# Telegram report
REPORT_TITLE=Vast Rust GPU Miner
REPORT_INTERVAL_MS=60000
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
TELEGRAM_CHAT_ID=1370196228

# Gas controls
PRIORITY_GWEI=1
MAX_FEE_GWEI=30
GAS_LIMIT_OVERRIDE=
